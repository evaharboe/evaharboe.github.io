---
import LifeShell from '../../components/LifeShell.astro';
import RetreatCard from '../../components/RetreatCard.astro';
import { getCollection } from 'astro:content';
import { pastWithPhotos, upcomingRetreat } from '../../data/life';
const base = import.meta.env.BASE_URL;
const latest = pastWithPhotos[0];
const now = new Date();
const nextRace = (await getCollection('races')).filter((r) => r.data.date > now).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())[0];
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
---
<LifeShell current="overview" title="Move · Eva Harboe" description="Eva Harboe on yoga, running and retreats: teaching, races, and building communities around moving well.">
  <header class="intro">
    <p class="kicker">Yoga · Running · Retreats</p>
    <h1>Off the <em>screen.</em></h1>
    <p class="lead">
      Yoga classes, runs and retreats, built around one idea: everyone who turns up should feel welcome, known
      and at home.
    </p>
  </header>

  <section>
    <h2 class="label">Yoga</h2>
    <div class="content">
      <p>
        I trained at House of Om in Ubud, Bali, and now teach weekly classes for the Surrey Yoga Society, mostly
        rocket or power vinyasa, with the odd slow, yin-style stretch. Classes are open to complete beginners.
      </p>
      <dl class="figures">
        <div><dt>200hr</dt><dd>YTT certified</dd></div>
        <div><dt>~40</dt><dd>students a week</dd></div>
        <div><dt>4</dt><dd>retreats planned</dd></div>
      </dl>
      <a class="more" href={`${base}move/yoga/`}>More on my yoga →</a>
    </div>
  </section>

  <section>
    <h2 class="label">Retreats</h2>
    <div class="content">
      <p>Retreats are where it all comes together.</p>
      {upcomingRetreat && (
        <article class="rcard upcoming">
          <span class="when">Next · {upcomingRetreat.when} · {upcomingRetreat.kind}</span>
          <h3>{upcomingRetreat.place}</h3>
          <p>{upcomingRetreat.text}</p>
        </article>
      )}
      {latest && <RetreatCard r={latest} teaser />}
      <a class="more" href={`${base}move/retreats/`}>All retreats and what's next →</a>
    </div>
  </section>

  <nav class="strips" aria-label="More on the Move side">
    <a href={`${base}move/running/`}>
      <span class="label">Running</span>
      <span class="strip-text">{nextRace ? <>Next race: {nextRace.data.name}, {fmt(nextRace.data.date)}</> : 'All my races so far'}</span>
      <span class="arrow">→</span>
    </a>
    <a href={`${base}move/about/`}>
      <span class="label">About me</span>
      <span class="strip-text">From Stavanger and handball to yoga, running and retreats</span>
      <span class="arrow">→</span>
    </a>
  </nav>
</LifeShell>
