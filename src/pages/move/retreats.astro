---
import LifeShell from '../../components/LifeShell.astro';
import RetreatCard from '../../components/RetreatCard.astro';
import { upcomingRetreat, pastWithPhotos, pastNoPhotos, retreatIdeas } from '../../data/life';
---
<LifeShell current="retreats" title="Retreats · Eva Harboe" description="Yoga retreats Eva Harboe has planned for the Surrey Yoga Society, and the kinds she'd love to run next.">
  <header class="sub-intro">
    <p class="kicker">Move</p>
    <h1>Retreats</h1>
    <p class="lead">
      Retreats are where it all comes together. I've planned four for the yoga society so far, each one a
      little better than the last.
    </p>
  </header>

  <section>
    <h2 class="label">What's next</h2>
    <div class="content">
      {upcomingRetreat && (
        <article class="rcard upcoming">
          <span class="when">Next · {upcomingRetreat.when} · {upcomingRetreat.kind}</span>
          <h3>{upcomingRetreat.place}</h3>
          <p>{upcomingRetreat.text}</p>
        </article>
      )}
      <p>
        After that, these are the kinds I'd love to run. The active ones keep the yoga to a morning and an evening
        session, so the day is free for the activity.
      </p>
      <ol class="ideas">
        {retreatIdeas.map((i) => (
          <li><span class="idea-title">{i.title}</span><span class="idea-text">{i.text}</span></li>
        ))}
      </ol>
    </div>
  </section>
  <section>
    <h2 class="label">Past retreats</h2>
    <div class="content">
      {pastWithPhotos.map((r) => <RetreatCard r={r} />)}
      {pastNoPhotos.length > 0 && (
        <div class="cards">
          {pastNoPhotos.map((r) => (
            <article class="rcard">
              <span class="when">{r.when} · {r.kind}</span>
              <h3>{r.place}</h3>
              <p>{r.text}</p>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

</LifeShell>
