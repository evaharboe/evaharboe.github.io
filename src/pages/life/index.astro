---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const races = (await getCollection('races')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const now = new Date();
const upcoming = races.filter((r) => r.data.date > now).reverse();
const done = races.filter((r) => r.data.date <= now);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });

// Retreat styles Eva wants to build towards. Edit freely.
const retreatIdeas = [
  { title: 'Run & yoga', text: 'Morning trail runs, afternoon mobility, evening yin. Built for runners who never stretch.' },
  { title: 'Hike & yoga', text: 'Long days in the mountains, slow practice at the end of them.' },
  { title: 'Surf & yoga', text: 'Water in the morning, strength and balance on the mat.' },
  { title: 'Pure yoga', text: 'Time away to go deeper into practice, with space to rest.' },
];

// Life side. IMPORTANT (visa): until the Graduate visa, keep this page about practice and community.
// No prices, booking links or "hire me". An "Offerings" / "For workplaces" section can go in from July 2027.
---
<Base side="life" title="Life · Eva Harboe" description="Eva Harboe on yoga, running and retreats: teaching, races, and building communities around moving well.">
  <div class="page">
    <header class="intro">
      <p class="kicker">Yoga · Running · Retreats</p>
      <h1>Move well,<br /><em>together.</em></h1>
      <p class="lead">
        I teach yoga, I'm learning to run long, and I love bringing people somewhere beautiful to do both.
        Everything here comes back to one thing: making movement feel welcoming, and building community around it.
      </p>
    </header>

    <section>
      <h2 class="label">Yoga</h2>
      <div class="content">
        <p>
          I'm a certified yoga teacher. I teach weekly classes and lead retreats for the Surrey Yoga Society,
          where I was president for two terms. When I started teaching, I focused on making classes feel like a
          community rather than just a class, and attendance doubled.
        </p>
        <p>
          Next is my 300-hour training, with a focus on yoga for runners: mobility, strength and recovery for
          people who spend a lot of time on their feet.
        </p>
        <!-- TODO(Eva): your 200hr school/style, and a photo of you teaching -->
        <dl class="figures">
          <div><dt>~40</dt><dd>people a week</dd></div>
          <div><dt>3</dt><dd>retreats led</dd></div>
          <div><dt>300hr</dt><dd>training next</dd></div>
        </dl>
      </div>
    </section>

    <section>
      <h2 class="label">Running</h2>
      <div class="content">
        <p>
          I was a sprinter and handball player, and distance running was the punishment for turning up late.
          In 2026 I decided to change that.
        </p>
        <ul class="races">
          {upcoming.map((r) => (
            <li class="upcoming">
              <span class="race-name">{r.data.name}<small>{r.data.distance} · {fmt(r.data.date)}</small></span>
              <span class="race-time">Coming up</span>
            </li>
          ))}
          {done.map((r) => (
            <li>
              <span class="race-name">{r.data.name}<small>{r.data.distance} · {fmt(r.data.date)}</small></span>
              <span class="race-time">{r.data.time}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section>
      <h2 class="label">Retreats</h2>
      <div class="content">
        <p>
          I've planned and led three retreats for the yoga society, in England and abroad. One day I'd like to
          build retreats that pair movement with places worth travelling to.
        </p>
        <ol class="ideas">
          {retreatIdeas.map((i) => (
            <li><span class="idea-title">{i.title}</span><span class="idea-text">{i.text}</span></li>
          ))}
        </ol>
      </div>
    </section>

    <section>
      <h2 class="label">Snow</h2>
      <div class="content">
        <p>
          I grew up skiing every weekend at our family cabin in Norway, and now go ski touring with my dad, most
          recently in Japan. Norwegian even has a word, <em>føre</em>, for the conditions snow creates.
        </p>
      </div>
    </section>

    <section>
      <h2 class="label">Elsewhere</h2>
      <div class="content">
        <p>
          35 countries, many of them solo. Travelling alone taught me to walk into somewhere new and get to know
          people quickly, which is most of what a good retreat needs.
        </p>
      </div>
    </section>
  </div>
</Base>

<style>
  .page { max-width: 880px; margin: 0 auto; padding: 0 20px; }
  @media (min-width: 700px) { .page { padding: 0 40px; } }

  .intro { padding: 120px 0 88px; }
  .kicker { font-size: .78rem; letter-spacing: .16em; text-transform: uppercase; color: var(--sage); margin-bottom: 1.6em; }
  h1 { font-size: clamp(2.8rem, 7vw, 5rem); font-weight: 400; line-height: 1.05; margin-bottom: .6em; }
  h1 em { font-style: italic; color: var(--moss); }
  .lead { font-size: 1.15rem; max-width: 560px; }

  section { display: grid; gap: 12px; padding: 48px 0; border-top: 1px solid var(--line); }
  @media (min-width: 760px) { section { grid-template-columns: 180px 1fr; gap: 40px; } }
  .label { font-family: var(--body-font); font-size: .78rem; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; color: var(--sage); margin: .45em 0 0; }
  .content { max-width: 600px; }
  .content > p { color: #3b3a33; }

  .figures { display: flex; gap: 40px; flex-wrap: wrap; margin: 32px 0 0; }
  .figures div { display: flex; flex-direction: column; }
  .figures dt { font-family: var(--serif); font-size: 2rem; color: var(--clay); line-height: 1.1; }
  .figures dd { margin: 0; font-size: .85rem; color: var(--muted); }

  .races, .ideas { list-style: none; padding: 0; margin: 28px 0 0; }
  .races li { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .races li:first-child { border-top: 1px solid var(--line); }
  .race-name { font-family: var(--serif); font-size: 1.15rem; color: var(--heading); }
  .race-name small { display: block; font-family: var(--body-font); font-size: .82rem; color: var(--muted); margin-top: 2px; }
  .race-time { font-family: var(--serif); font-size: 1.4rem; color: var(--heading); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .upcoming .race-time { font-family: var(--body-font); font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; color: var(--clay); }

  .ideas { counter-reset: idea; }
  .ideas li { counter-increment: idea; display: grid; grid-template-columns: 2.2em 1fr; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .ideas li::before { content: counter(idea, decimal-leading-zero); color: var(--sage); font-size: .85rem; padding-top: .25em; }
  .idea-title { font-family: var(--serif); font-size: 1.1rem; color: var(--heading); }
  .idea-text { grid-column: 2; color: var(--muted); font-size: .95rem; }
</style>
