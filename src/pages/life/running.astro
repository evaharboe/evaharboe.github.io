---
import LifeShell from '../../components/LifeShell.astro';
import RaceList from '../../components/RaceList.astro';
---
<LifeShell current="running" title="Running · Eva Harboe" description="Eva Harboe's races so far, from a first 10K to training for the Brighton Marathon.">
  <header class="sub-intro">
    <p class="kicker">Life</p>
    <h1>Running</h1>
  </header>
  <section>
    <h2 class="label">Races</h2>
    <div class="content">
      <p>Until April 2026, 500 metres was the furthest I'd ever run. Here's how it's going so far.</p>
      <RaceList />
    </div>
  </section>
</LifeShell>
