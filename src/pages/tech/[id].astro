---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, org, period, summary, tags } = project.data;
const base = import.meta.env.BASE_URL;
---
<Base side="tech" title={`${title} · Eva Harboe`} description={summary}>
  <article class="wrap">
    <a class="back" href={`${base}tech/`}>← All work</a>
    <p class="eyebrow">{org} · {period}</p>
    <h1>{title}</h1>
    <p class="lead">{summary}</p>
    <div class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</div>
    <div class="body"><Content /></div>
  </article>
</Base>

<style>
  article { padding-top: 56px; padding-bottom: 40px; max-width: 760px; }
  .back { display: inline-block; margin-bottom: 32px; text-decoration: none; }
  .tags { margin: 20px 0 40px; }
  .body :global(p) { font-size: 1.05rem; }
  .body :global(strong) { color: var(--text); }
  .body :global(h2) { font-size: 1.35rem; margin: 2.4em 0 .6em; }
  .body :global(ul), .body :global(ol) { padding-left: 1.2em; margin: 0 0 1.2em; }
  .body :global(li) { font-size: 1.05rem; margin: .45em 0; color: var(--muted); }
  .body :global(li strong) { color: var(--text); }
  .body :global(table) { width: 100%; border-collapse: collapse; margin: 1.2em 0 1.6em; font-size: .95rem; }
  .body :global(th), .body :global(td) { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--line); }
  .body :global(th) { color: var(--muted); font-weight: 500; }
  .body :global(td:last-child), .body :global(th:last-child) { text-align: right; font-variant-numeric: tabular-nums; }
  .body :global(.note) { font-size: .9rem; color: var(--muted); }
</style>
