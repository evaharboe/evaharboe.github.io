---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const experience = [
  { role: 'Engineering Intern (Placement Year)', org: 'Sony Europe, Basingstoke', period: 'Sep 2025 – Aug 2026',
    text: 'Led the 0-to-1 build of Wrangler Designer, researched real-time video deblurring, and built an Android reference app with the BBC.' },
  { role: 'Digital Assistant (Web Developer & UX Designer)', org: 'Surrey Students’ Union', period: 'Dec 2023 – Jun 2025',
    text: 'Built the vehicle booking and society management pages for a portal serving 10,000+ students, plus reusable templates so staff could publish safely.' },
  { role: 'Summer Programme: Robotics & AI Strategy', org: 'Seoul National University, South Korea', period: 'Summer 2024',
    text: 'Built and programmed a small humanoid robot, and researched a computer-vision guide dog proof of concept. Found that social trust, not technical feasibility, was the biggest barrier to adoption. Graded A+.' },
  { role: 'Founder & Owner', org: 'Luwa, Stavanger', period: 'Jun 2022 – Jun 2023',
    text: 'Started and ran a small jewellery business: product design, pricing, suppliers and manufacturing, plus an online store and its marketing.' },
  { role: 'BSc (Hons) Computer Science', org: 'University of Surrey', period: '2023 – 2027',
    text: 'On track for a First. Dean’s List 2023/24 and 2024/25. Final year project with CVSSP. PALS mentor and lab assistant, course representative and EDI committee member.' },
];

const leadership = [
  { role: 'President (two terms) & yoga teacher', org: 'Surrey Yoga Society', period: 'Apr 2024 – Jun 2026',
    text: 'Doubled average class attendance in a year by refocusing on community. Led a 9-person committee and ran the budgets and logistics for retreats in the UK and Cyprus.' },
  { role: 'UK Head of Digital Strategy', org: 'ANSA (Association of Norwegian Students Abroad)', period: 'Mar 2024 – Jun 2025',
    text: 'Ran the digital channels and kept the brand consistent across 14 UK regional groups.' },
];

const awards = [
  'Dean’s List, University of Surrey (2023/24 and 2024/25)',
  'SETsquared iKEEP Intrapreneurial Training Award',
  'Global Graduate Award in Entrepreneurship (83%)',
  'Finalist, Hackathon17: designed UX mock-ups for a Duolingo-style app to help adults in the UK learn to read',
];

const skills = ['TypeScript', 'React', 'ReactFlow', 'Zustand', 'Vue / Nuxt', 'Node.js', 'Django', 'Python', 'PyTorch', 'ONNX Runtime', 'TensorRT', 'Java', 'Kotlin', 'Jetpack Compose', 'SQL', 'AWS', 'Git'];
---
<Base side="tech" title="Build · Eva Harboe" description="Eva Harboe's software engineering work: Sony Wrangler Designer, computer vision research, Android, and BSL fingerspelling.">
  <section class="intro">
    <div class="wrap">
      <p class="eyebrow">Build</p>
      <h1>From a blank page<br />to a working product.</h1>
      <p class="lead">
        I like starting with the people: what they actually need, and what's getting in their way. Then building
        something that makes a real difference to them. Trilingual in English, Norwegian and French.
      </p>
      <p class="actions">
        <a class="btn" href="#work">See my work</a>
        <a class="btn ghost" href="#contact">Get in touch</a>
      </p>
    </div>
  </section>

  <section class="band" id="work">
    <div class="wrap">
      <h2>Selected work</h2>
      <div class="grid two">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>Experience</h2>
      <ol class="timeline">
        {experience.map((e) => (
          <li>
            <p class="period">{e.period}</p>
            <h3>{e.role}</h3>
            <p class="org">{e.org}</p>
            <p>{e.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>Leadership</h2>
      <ol class="timeline">
        {leadership.map((e) => (
          <li>
            <p class="period">{e.period}</p>
            <h3>{e.role}</h3>
            <p class="org">{e.org}</p>
            <p>{e.text}</p>
          </li>
        ))}
      </ol>
      <h2 class="sub">Awards</h2>
      <ul class="awards">{awards.map((a) => <li>{a}</li>)}</ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>Tools I reach for</h2>
      <div>{skills.map((s) => <span class="tag">{s}</span>)}</div>
    </div>
  </section>
</Base>

<style>
  .intro { padding: 120px 0 96px; text-align: center; }
  .intro h1 { font-size: clamp(2.8rem, 8vw, 5.6rem); background: linear-gradient(180deg, #fff 30%, #8a8a90); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .intro .lead { margin: 0 auto; }
  .actions { justify-content: center; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
  .timeline { list-style: none; padding: 0; margin: 0; border-left: 1px solid var(--line); }
  .timeline li { padding: 0 0 36px 28px; position: relative; }
  .timeline li::before { content: ''; position: absolute; left: -8px; top: 6px; width: 14px; height: 14px; border-radius: 50%; background: var(--accent); border: 3px solid var(--bg); }
  .period { font-size: .85rem; color: var(--accent); margin-bottom: .2em; }
  .org { color: var(--muted); margin-bottom: .4em; }
  .sub { margin-top: 48px; }
  .awards { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .awards li { padding: 14px 0; border-bottom: 1px solid var(--line); color: var(--text); }
  .tag { font-size: .9rem; padding: 7px 15px; background: var(--surface); color: var(--text); border: 1px solid var(--line); }
</style>
