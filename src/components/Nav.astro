---
import SideSwitch from './SideSwitch.astro';
import type { Side } from '../config';
interface Props { side: Side | 'home' }
const { side } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<header class:list={[{ floating: side === 'home' }]}>
  <nav class="wrap">
    <a class="name" href={base}>Eva Harboe</a>
    <SideSwitch side={side} />
    <a class="contact" href={side === 'home' ? 'mailto:you@example.com' : '#contact'}>Contact</a>
  </nav>
</header>

<style>
  header { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: saturate(180%) blur(14px); border-bottom: 1px solid var(--line); }
  header.floating { position: absolute; left: 0; right: 0; background: transparent; border: 0; backdrop-filter: none; }
  nav { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 68px; gap: 12px; }
  .name { font-family: var(--heading-font); font-weight: var(--heading-weight); font-size: 1.1rem; color: var(--heading); text-decoration: none; white-space: nowrap; }
  .contact { justify-self: end; text-decoration: none; color: var(--muted); font-size: .92rem; }
  .contact:hover { color: var(--text); }
  .floating .name { color: #f5f5f7; font-family: var(--sans); font-weight: 600; }
  .floating .contact { color: var(--forest); }
  @media (max-width: 560px) {
    nav { grid-template-columns: 1fr auto; }
    .contact { display: none; }
    .name { font-size: 1rem; }
  }
</style>
