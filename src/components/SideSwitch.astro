---
import { SIDES, type Side } from '../config';
interface Props { side: Side | 'home' }
const { side } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<div class="switch" data-active={side} role="navigation" aria-label="Choose a side">
  <span class="knob" aria-hidden="true"></span>
  {(Object.keys(SIDES) as Side[]).map((key) => (
    <a href={`${base}${SIDES[key].path}`} data-to={key} aria-current={side === key ? 'page' : undefined}>
      {SIDES[key].label}
    </a>
  ))}
</div>

<script>
  // Flip the switch: slide the knob, wipe the screen in the new side's colour, then navigate.
  document.querySelectorAll<HTMLAnchorElement>('.switch a').forEach((link) => {
    link.addEventListener('click', (e) => {
      const to = link.dataset.to!;
      const sw = link.closest<HTMLElement>('.switch')!;
      if (sw.dataset.active === to) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      e.preventDefault();
      sw.dataset.active = to;
      document.querySelector('.wipe')?.classList.add(`to-${to}`);
      setTimeout(() => { window.location.href = link.href; }, 420);
    });
  });
</script>

<style>
  .switch {
    position: relative; display: inline-grid; grid-template-columns: 1fr 1fr;
    padding: 4px; border-radius: 999px; font-family: var(--sans); font-size: .9rem; font-weight: 500;
    background: var(--surface); border: 1px solid var(--line);
  }
  .knob {
    position: absolute; top: 4px; bottom: 4px; left: 4px; width: calc(50% - 4px); border-radius: 999px;
    background: #f5f5f7; transition: transform .38s cubic-bezier(.7,0,.3,1), background .38s ease, opacity .2s;
  }
  .switch[data-active="home"] .knob { opacity: 0; }
  .switch[data-active="life"] .knob { transform: translateX(100%); background: var(--moss); }
  .switch[data-active="tech"] .knob { background: #f5f5f7; }
  a { position: relative; z-index: 1; padding: 7px 22px; text-align: center; text-decoration: none; color: var(--muted); transition: color .3s; min-width: 76px; }
  a:hover { color: var(--text); }
  .switch[data-active="tech"] a[data-to="tech"] { color: #000; }
  .switch[data-active="life"] a[data-to="life"] { color: var(--cream); }
</style>

<style>
  /* On the split homepage the switch straddles both halves */
  .switch[data-active="home"] { background: linear-gradient(90deg, #161618 50%, #fffdf8 50%); border-color: #3a3a3e; }
  .switch[data-active="home"] a[data-to="tech"] { color: #f5f5f7; }
  .switch[data-active="home"] a[data-to="life"] { color: #2c3a2a; }
</style>

<style>
  @media (max-width: 560px) { a { padding: 7px 14px; min-width: 0; } }
</style>
