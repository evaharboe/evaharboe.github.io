---
// Wrapper for every Life page: the shared styling plus the tab bar.
import Base from '../layouts/Base.astro';
import '../styles/life.css';

interface Props { title: string; description: string; current: 'overview' | 'yoga' | 'retreats' | 'running' | 'about' }
const { title, description, current } = Astro.props;
const base = import.meta.env.BASE_URL;
const tabs = [
  { id: 'overview', label: 'Overview', href: `${base}move/` },
  { id: 'yoga', label: 'Yoga', href: `${base}move/yoga/` },
  { id: 'retreats', label: 'Retreats', href: `${base}move/retreats/` },
  { id: 'running', label: 'Running', href: `${base}move/running/` },
  { id: 'about', label: 'About me', href: `${base}move/about/` },
];
---
<Base side="life" title={title} description={description}>
  <div class="lp page">
    <nav class="tabs" aria-label="Move sections">
      {tabs.map((t) => <a href={t.href} aria-current={t.id === current ? 'page' : undefined}>{t.label}</a>)}
    </nav>
    <slot />
  </div>
</Base>
